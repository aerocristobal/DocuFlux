# Allowlist-only HAProxy config for the surya-controller (bead DocuFlux-6b5).
# Replaces the image's stock template (the entrypoint renders it to haproxy.cfg
# at start). The stock CONTAINERS=1 ACL is a path-prefix regex, so with POST=1
# it forwarded POST /containers/create and /containers/{id}/exec, a host-escape
# path. Here exactly four requests are forwarded; everything else gets 403.
# Anchored with $ so no sub-path or suffix slips through; `path` excludes the
# query string, so ?all=1&filters=... on the list call is unaffected.
global
    log stdout format raw daemon "${LOG_LEVEL}"

    pidfile /run/haproxy.pid
    maxconn 4000

    # Turn on stats unix socket
    server-state-file /var/lib/haproxy/server-state

defaults
    mode http
    log global
    option httplog
    option dontlognull
    option http-server-close
    option redispatch
    retries 3
    timeout http-request 10s
    timeout queue 1m
    timeout connect 10s
    timeout client 10m
    timeout server 10m
    timeout http-keep-alive 10s
    timeout check 10s
    maxconn 3000

    # Allow seamless reloads
    load-server-state-from-file global

    # Use provided example error pages
    errorfile 400 /usr/local/etc/haproxy/errors/400.http
    errorfile 403 /usr/local/etc/haproxy/errors/403.http
    errorfile 408 /usr/local/etc/haproxy/errors/408.http
    errorfile 500 /usr/local/etc/haproxy/errors/500.http
    errorfile 502 /usr/local/etc/haproxy/errors/502.http
    errorfile 503 /usr/local/etc/haproxy/errors/503.http
    errorfile 504 /usr/local/etc/haproxy/errors/504.http

backend dockerbackend
    server dockersocket $SOCKET_PATH

frontend dockerfrontend
    bind ${BIND_CONFIG}
    http-request deny unless METH_GET || METH_POST
    http-request allow if METH_GET { path,url_dec -m reg -i ^(/v[\d\.]+)?/_ping$ }
    http-request allow if METH_GET { path,url_dec -m reg -i ^(/v[\d\.]+)?/containers/json$ }
    http-request allow if METH_POST { path,url_dec -m reg -i ^(/v[\d\.]+)?/containers/[a-zA-Z0-9]+/(start|stop)$ }
    http-request deny
    default_backend dockerbackend
